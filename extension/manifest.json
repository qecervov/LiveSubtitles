{
  "manifest_version": 3,
  "name": "LiveSubtitles — локальный перевод видео",
  "version": "0.1.0",
  "version_name": "0.1.0-alpha",
  "description": "Перевод звука текущей вкладки в субтитры. Бесплатная обработка на вашем компьютере.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "tabCapture", "offscreen", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Перевод видео"},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:8765 ws://127.0.0.1:8765"
  }
}
